Profiles for main security chain (with "/**" pattern) to be imported in security-applicationContext.xml.
Only one profile can be active at a time.
Which profile to activate is currently chosen by SpringProfileActivatorListener
based on hadoop.http.authentication.jwt.enabled property in core-site.xml:
false (default) - classic-login
true - oidc-login
When adding any changes to classic-login variant, consider adding them to oidc-login variant too.

NOTE: the only reason for splitting into 2 profiles is that we want to programmatically
enable/disable oauth2-login feature, which seems to only be possible through profiles
when using XML-based configuration. If we were using Java-based configuration, we could easily go with:
if (condition) {
	http.outh2Login(...);
}
without going into profiles. Consider this, if you will ever move to Java-based configuration.
-->

<beans:beans xmlns="http://www.springframework.org/schema/security"
			 xmlns:beans="http://www.springframework.org/schema/beans"
			 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			 xmlns:security="http://www.springframework.org/schema/security"
			 xsi:schemaLocation="http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans-4.3.xsd
http://www.springframework.org/schema/security
http://www.springframework.org/schema/security/spring-security-5.7.xsd">

	<!-- Classic login with Ranger login page -->
	<beans:beans profile="classic-login">
		<security:http disable-url-rewriting="true" use-expressions="true" create-session="always" entry-point-ref="authenticationProcessingFilterEntryPoint">
			<csrf disabled="true"/>
			<security:headers>
				<security:frame-options/>
				<security:cache-control/>
				<security:content-type-options/>
				<security:xss-protection/>
				<security:hsts/>
				<security:content-security-policy policy-directives="default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline';font-src 'self'"/>
			</security:headers>
			<security:session-management session-fixation-protection="newSession" />
			<intercept-url pattern="/**" access="isAuthenticated()"/>
			<custom-filter ref="ssoAuthenticationFilter" after="BASIC_AUTH_FILTER" />
			<security:custom-filter ref="krbAuthenticationFilter" after="SERVLET_API_SUPPORT_FILTER" />
			<security:custom-filter ref="maprAuthenticationFilter" after="ANONYMOUS_FILTER"/>
			<security:custom-filter ref="CSRFPreventionFilter" after="REMEMBER_ME_FILTER" />
			<security:custom-filter position="FORM_LOGIN_FILTER" ref="customUsernamePasswordAuthenticationFilter"/>
			<security:custom-filter position="LAST" ref="userContextFormationFilter"/>

			<security:access-denied-handler error-page="/login.jsp"/>
			<security:logout delete-cookies="${ranger.admin.cookie.name}" logout-url="/logout" success-handler-ref="customLogoutSuccessHandler"/>
			<http-basic entry-point-ref="authenticationProcessingFilterEntryPoint"/>
		</security:http>
	</beans:beans>

	<!--
		SSO login:
		- unauthenticated users are redirected to configured IdP (such as Keycloak) to log in
		- after successful authentication an id token (JWT) is generated and set in cluster-wide cookie
		- users can authenticate with that JWT either in Bearer header or in cookie
	-->
	<beans:beans profile="oidc-login">
		<security:http disable-url-rewriting="true" use-expressions="true" create-session="always" entry-point-ref="delegatingAuthenticationEntryPoint">
			<csrf disabled="true"/>
			<security:headers>
				<security:frame-options/>
				<security:cache-control/>
				<security:content-type-options/>
				<security:xss-protection/>
				<security:hsts/>
				<security:content-security-policy policy-directives="default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline';font-src 'self'"/>
			</security:headers>
			<security:session-management session-fixation-protection="newSession" />
			<intercept-url pattern="/**" access="isAuthenticated()"/>
			<security:custom-filter ref="krbAuthenticationFilter" after="SERVLET_API_SUPPORT_FILTER" />
			<security:custom-filter ref="maprAuthenticationFilter" after="ANONYMOUS_FILTER"/>
			<security:custom-filter ref="CSRFPreventionFilter" after="REMEMBER_ME_FILTER" />
			<security:custom-filter position="FORM_LOGIN_FILTER" ref="customUsernamePasswordAuthenticationFilter"/>
			<security:custom-filter position="LAST" ref="userContextFormationFilter"/>

			<security:access-denied-handler error-page="/login.jsp"/>
			<security:logout delete-cookies="${ranger.admin.cookie.name}" logout-url="/logout" success-handler-ref="customOidcLogoutSuccessHandler" />
			<http-basic entry-point-ref="authenticationProcessingFilterEntryPoint"/>

			<oauth2-login oidc-user-service-ref="customOidcUserService" client-registration-repository-ref="clientRegistrationRepository" authentication-success-handler-ref="homeAuthenticationSuccessHandler" jwt-decoder-factory-ref="idTokenDecoderFactory"/>
			<oauth2-resource-server>
				<jwt decoder-ref="jwtDecoder" jwt-authentication-converter-ref="jwtAuthenticationConverter"/>
			</oauth2-resource-server>
		</security:http>

		<beans:bean id="oauth2LoginEntryPoint" class="org.springframework.security.web.authentication.LoginUrlAuthenticationEntryPoint">
			<beans:constructor-arg value="/oauth2/authorization/login"/>
		</beans:bean>

		<beans:bean id="homeAuthenticationSuccessHandler" class="org.springframework.security.web.authentication.SimpleUrlAuthenticationSuccessHandler">
			<beans:property name="defaultTargetUrl" value="/" />
			<beans:property name="alwaysUseDefaultTargetUrl" value="true" />
		</beans:bean>

		<beans:bean id="oidcAuthenticationRequestMatcher" class="org.springframework.security.web.util.matcher.AntPathRequestMatcher">
			<beans:constructor-arg value="/ssologin" />
		</beans:bean>

		<beans:bean id="delegatingAuthenticationEntryPoint" class="org.springframework.security.web.authentication.DelegatingAuthenticationEntryPoint">
			<beans:constructor-arg>
				<beans:map>
					<beans:entry key-ref="oidcAuthenticationRequestMatcher" value-ref="oauth2LoginEntryPoint" />
				</beans:map>
			</beans:constructor-arg>
			<beans:property name="defaultEntryPoint" ref="authenticationProcessingFilterEntryPoint"/>
		</beans:bean>

		<beans:bean id="customOidcLogoutSuccessHandler" class="org.apache.ranger.security.oidc.CustomOidcLogoutSuccessHandler">
			<beans:constructor-arg ref="customLogoutSuccessHandler"/>
		</beans:bean>

		<beans:bean id="clientRegistrationRepository" class="org.apache.ranger.security.oidc.ClientRegistrationRepositoryFactory" factory-method="createClientRegistrationRepository"/>

		<beans:bean id="idTokenDecoderFactory" class="org.apache.ranger.security.oidc.IdTokenDecoderFactory" factory-method="createIdTokenDecoderFactory"/>

		<beans:bean id="defaultOidcUserService" class="org.springframework.security.oauth2.client.oidc.userinfo.OidcUserService"/>

		<beans:bean id="customOidcUserService" class="org.apache.ranger.security.oidc.RangerOidcUserService">
			<beans:constructor-arg ref="defaultOidcUserService"/>
		</beans:bean>

		<beans:bean id="jwtDecoder" class="org.springframework.security.oauth2.jwt.JwtDecoders" factory-method="fromOidcIssuerLocation">
			<beans:constructor-arg value="#{ T(org.apache.hadoop.security.authentication.util.SsoConfigurationUtil).getInstance().getClientIssuer() }"/>
		</beans:bean>

		<beans:bean id="jwtAuthenticationConverter" class="org.springframework.security.oauth2.server.resource.authentication.JwtAuthenticationConverter">
			<beans:property name="principalClaimName" value="#{ T(org.apache.hadoop.security.authentication.util.SsoConfigurationUtil).getInstance().getUserAttrName() }"/>
		</beans:bean>
	</beans:beans>
</beans:beans>
