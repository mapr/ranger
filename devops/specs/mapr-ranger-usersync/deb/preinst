#!/bin/bash

[ -n "$VERBOSE" ] && echo "preinst called with arguments ${1}, ${2}" >&2
[ -n "$VERBOSE" ] && set -x

case "$1" in
    install)
    ;;

# CONF_BACKUP - save old configs in OLD_TIMESTAMP/conf directory (any upgrade)
# CONF_OVERWRITE - overwrite new configs with old ones (ONLY if first 3 digits HAVE NOT been changed)

    upgrade)

        OLD_TIMESTAMP="$2"
        OLD_VERSION=$( echo ${OLD_TIMESTAMP} | cut -d'.' -f1-3 )

	# ====== CONF_BACKUP start ======

        mkdir -p __PREFIX__/ranger/ranger-${OLD_TIMESTAMP}/conf/ranger-usersync
        if [ -f __PREFIX__/ranger/ranger-${OLD_VERSION}/conf/warden.ranger-usersync.conf ]; then
            cp __PREFIX__/ranger/ranger-${OLD_VERSION}/conf/warden.ranger-usersync.conf __PREFIX__/ranger/ranger-${OLD_TIMESTAMP}/conf/ranger-usersync
        fi

        cp __PREFIX__/ranger/ranger-${OLD_VERSION}/ranger-usersync/install.properties __PREFIX__/ranger/ranger-${OLD_TIMESTAMP}/conf/ranger-usersync
        if [ -f __PREFIX__/ranger/ranger-${OLD_VERSION}/ranger-usersync/conf/ranger-ugsync-site.xml ]; then
            cp __PREFIX__/ranger/ranger-${OLD_VERSION}/ranger-usersync/conf/ranger-ugsync-site.xml __PREFIX__/ranger/ranger-${OLD_TIMESTAMP}/conf/ranger-usersync
        fi

        DAEMON_CONF=__PREFIX__/conf/daemon.conf
        if [ -f "$DAEMON_CONF" ]; then
            MAPR_USER=$( awk -F = '$1 == "mapr.daemon.user" { print $2 }' $DAEMON_CONF)
            MAPR_GROUP=$( awk -F = '$1 == "mapr.daemon.group" { print $2 }' $DAEMON_CONF)
            if [ ! -z "$MAPR_USER" ]; then
                chown -R ${MAPR_USER}:${MAPR_GROUP} __PREFIX__/ranger/ranger-${OLD_TIMESTAMP}
            fi
        fi

	# ====== CONF_BACKUP end ======

	# ====== CONF_OVERWRITE start ======

	# Comparing first 3 digits
	if [ "__VERSION_3DIGIT__" = "$OLD_VERSION" ]; then
		mkdir -p "__PREFIX__/ranger/ranger-__VERSION_3DIGIT__"/.conf.backup/usersync
		cp __PREFIX__/ranger/ranger-${OLD_VERSION}/ranger-usersync/install.properties "__PREFIX__/ranger/ranger-__VERSION_3DIGIT__"/.conf.backup/usersync
		if [ -f __PREFIX__/ranger/ranger-${OLD_VERSION}/ranger-usersync/conf/ranger-ugsync-site.xml ]; then
		    cp __PREFIX__/ranger/ranger-${OLD_VERSION}/ranger-usersync/conf/ranger-ugsync-site.xml "__PREFIX__/ranger/ranger-__VERSION_3DIGIT__"/.conf.backup/usersync
		fi
	fi

	# ====== CONF_OVERWRITE end ======
    ;;

    abort-upgrade)
    ;;

    *)
        echo "preinst called with unknown argument ${1}" >&2
        exit 1
    ;;
esac
